# ==============================================================================
# SERVER-SIDE SECURITY ENVIRONMENT VARIABLES (Configure in Vercel Dashboard)
# NEVER commit real secrets to GitHub or expose them with a VITE_ prefix!
# ==============================================================================

# 1. Persistent Database (Supabase Postgres — Required for global lock sync & sessions)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Owner Security Bootstrap (Required for first-time owner login / setup)
# Generate a bcrypt hash or set a strong secret used only for initial owner setup:
#   node -e "import('bcryptjs').then(b => console.log(b.default.hashSync('YourStrongOwnerPassword', 12)))"
OWNER_BOOTSTRAP_SECRET=replace-with-random-32-byte-hex-secret
SECURITY_IP_PEPPER=replace-with-random-32-byte-hex-pepper

# 3. Private Owner Recovery Destinations (Kept server-side only; never exposed raw)
OWNER_RECOVERY_EMAIL=your-private-recovery-email@example.com
OWNER_RECOVERY_PHONE=+44XXXXXXXXXX

# 4. Email OTP Provider (Resend — https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
OTP_EMAIL_FROM=Security <security@yourdomain.com>

# 5. SMS OTP Provider (Twilio — https://twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+44XXXXXXXXXX
